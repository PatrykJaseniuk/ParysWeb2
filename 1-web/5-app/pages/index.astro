---
import BaseLayout from "../../4-layouts/BaseLayout.astro";
import Hero from "../../3-components/sections/Hero.astro";
import Marquee from "../../3-components/sections/Marquee.astro";
import Zones from "../../3-components/sections/Zones.astro";
import Pricing from "../../3-components/sections/Pricing.astro";
import Classes from "../../3-components/sections/Classes.astro";
import Trainers from "../../3-components/sections/Trainers.astro";
import Services from "../../3-components/sections/Services.astro";
import Partners from "../../3-components/sections/Partners.astro";
import ContactSection from "../../3-components/sections/ContactSection.astro";

const description =
  "Siłownia i klub fitness w Nysie, czynne całą dobę. 1000 m², sześć stref treningowych, Cross, sauna i badminton. Karnety od 35 zł, bez umowy lojalnościowej.";
---

<BaseLayout
  title="Sport Studio Parys"
  description={description}
  canonical="/"
>
  <Hero />
  <Marquee />
  <Zones />
  <Pricing />
  <Classes />
  <Trainers />
  <Services />
  <Partners />
  <ContactSection />
</BaseLayout>
