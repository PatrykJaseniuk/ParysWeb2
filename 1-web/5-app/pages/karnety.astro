---
import BaseLayout from "../../4-layouts/BaseLayout.astro";
import PageHero from "../../2-ui/ui/PageHero.astro";
import Icon from "../../2-ui/ui/Icon.astro";
import PriceMatrix from "../../3-components/pricing/PriceMatrix.astro";
import CtaBand from "../../3-components/sections/CtaBand.astro";
import { areas, contact, enrollmentFee, memberships, pln } from "../../1-data/business";
import { breadcrumbSchema, faqSchema } from "../../2-ui/seo";

const faq = [
  {
    q: "Czy muszę podpisywać umowę?",
    a: "Nie. Karnety kupujesz na określony czas — nie podpisujesz umowy lojalnościowej ani zobowiązania na kolejne miesiące. Jednorazowo przy pierwszym zakupie doliczamy opłatę wpisową 15 zł.",
  },
  {
    q: "Który karnet obejmuje zajęcia grupowe?",
    a: "Zajęcia grupowe (Cross trening i boks) obejmuje karnet „6 stref + zajęcia grupowe”. Karnet „4 strefy + cross” daje dostęp do zajęć Cross trening, ale nie do strefy Sala cross.",
  },
  {
    q: "Czym różni się „4 strefy + cross” od „6 stref + zajęcia grupowe”?",
    a: "„4 strefy + cross” to cztery strefy treningowe plus zajęcia Cross trening. „6 stref + zajęcia grupowe” to wszystkie sześć stref (w tym Sala cross i rollmasaż) oraz oba rodzaje zajęć — Cross trening i boks.",
  },
  {
    q: "Czy mogę zawiesić karnet?",
    a: "Tak. Karnety miesięczne i roczne mają możliwość zablokowania — szczegóły ustalisz w recepcji.",
  },
  {
    q: "Czy przysługuje mi zniżka jako uczniowi lub seniorowi?",
    a: "Tak, w zakresie „4 strefy” karnet miesięczny kosztuje 129 zł dla uczniów i studentów do 26 roku życia oraz seniorzy od 67 roku życia. Wymagane okazanie dokumentu.",
  },
  {
    q: "Czy karta MultiSport działa całą dobę?",
    a: "MultiSport — dostęp w godzinach pracy recepcji. Medicover Sport i FitProfit — dostęp całodobowy dla zarejestrowanych klientów. Karty działają w karnetach „4 strefy” i „4 strefy + cross”.",
  },
  {
    q: "Jakie są godziny pracy recepcji?",
    a: `Recepcja: poniedziałek–piątek 8:00–22:00, sobota 9:00–14:00. Klub jest czynny całą dobę dla posiadaczy karnetów. W niedziele i święta recepcja jest nieczynna — wejście na kartę.`,
  },
  {
    q: "Czy ceny są aktualne?",
    a: "Cennik odzwierciedla stan z poprzedniej wersji strony i wymaga potwierdzenia w recepcji. Przed zakupem upewnij się telefonicznie pod numerem 77 433 63 01.",
  },
];

const steps = [
  {
    title: "Przyjdź do recepcji",
    text: "Recepcja jest czynna pon–pt 8:00–22:00 i w sobotę 9:00–14:00. Możesz też zadzwonić wcześniej.",
  },
  {
    title: "Wybierz zakres",
    text: "Cztery strefy, pięć stref, sześć stref z zajęciami albo cztery strefy z crossem — doradzimy na miejscu.",
  },
  {
    title: "Odbierz kartę",
    text: `Po opłaceniu karnetu i jednorazowej opłaty wpisowej (${pln(enrollmentFee)}) dostajesz kartę i wchodzisz 24/7.`,
  },
];
---

<BaseLayout
  title="Karnety i cennik"
  description="Cennik karnetów Sport Studio Parys w Nysie: 4 strefy, 5 stref, 6 stref z zajęciami grupowymi i 4 strefy + cross. Wejście od 25 zł, karnet miesięczny od 139 zł, bez umowy."
  canonical="/karnety"
  jsonLd={[
    breadcrumbSchema([{ name: "Karnety", href: "/karnety" }]),
    faqSchema(faq),
  ]}
>
  <PageHero
    index="03"
    label="Karnety"
    title="Cennik karnetów"
    description="Cztery zakresy i dwadzieścia wariantów — od pojedynczego wejścia po karnet roczny z dwoma miesiącami gratis. Bez umowy lojalnościowej, z możliwością zablokowania karnetu."
    breadcrumbs={[{ name: "Karnety", href: "/karnety" }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <span class="flex items-center gap-2 border border-line px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-bone/70">
        <Icon name="check" size={12} class="text-brand" />
        Bez umowy
      </span>
      <span class="flex items-center gap-2 border border-line px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-bone/70">
        <Icon name="clock" size={12} class="text-brand" />
        Dostęp 24/7
      </span>
      <span class="flex items-center gap-2 border border-line px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-bone/70">
        <Icon name="users" size={12} class="text-brand" />
        MultiSport i Medicover
      </span>
    </div>
  </PageHero>

  <!-- Cennik -->
  <section class="bg-bone text-ink">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <PriceMatrix tone="light" />

      <div class="mt-12 grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-3">
        <div class="bg-bone p-6">
          <h2 class="font-display text-base font-bold uppercase tracking-tight">Opłata wpisowa</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-black/60">
            Jednorazowo {pln(enrollmentFee)} przy pierwszym zakupie karnetu. Nie dotyczy wejść
            jednorazowych.
          </p>
        </div>
        <div class="bg-bone p-6">
          <h2 class="font-display text-base font-bold uppercase tracking-tight">Czas trwania</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-black/60">
            Warianty 2-tygodniowe, miesięczne, 2-miesięczne (wejścia) i roczne. Karnet roczny
            zawiera dwa miesiące gratis.
          </p>
        </div>
        <div class="bg-bone p-6">
          <h2 class="font-display text-base font-bold uppercase tracking-tight">Karty partnerskie</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-black/60">
            MultiSport w godzinach pracy recepcji. Medicover Sport i FitProfit — 24/7 dla
            zarejestrowanych klientów.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Zakres karnetów -->
  <section class="border-t border-line">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <h2 class="eyebrow">Zakres</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-mist">
        Co dokładnie obejmuje każdy karnet. Strefy oznaczamy zgodnie z nazwami sal.
      </p>

      <div class="mt-8 overflow-x-auto">
        <table class="w-full min-w-[720px] border-collapse text-left">
          <thead>
            <tr>
              <th scope="col" class="border-b border-line px-3 py-3 font-mono text-[10px] uppercase tracking-[0.18em] text-mist">
                Karnet
              </th>
              {
                areas.map((area) => (
                  <th scope="col" class="border-b border-line px-3 py-3 text-center font-mono text-[9px] uppercase leading-tight tracking-[0.1em] text-mist">
                    {area.name}
                  </th>
                ))
              }
              <th scope="col" class="border-b border-line px-3 py-3 text-center font-mono text-[9px] uppercase leading-tight tracking-[0.1em] text-mist">
                Zajęcia
              </th>
            </tr>
          </thead>
          <tbody>
            {
              memberships.map((membership) => (
                <tr class="group">
                  <th scope="row" class="border-b border-line/70 px-3 py-4 align-middle font-normal">
                    <span class="block font-display text-sm font-semibold uppercase tracking-tight text-bone">
                      {membership.name}
                    </span>
                    <span class="mt-0.5 block text-[11px] text-mist/80">{membership.subtitle ?? ""}</span>
                  </th>
                  {areas.map((area) => {
                    const included = membership.areas_included.includes(area.id);
                    return (
                      <td class="border-b border-line/70 px-3 py-4 text-center">
                        {included ? (
                          <Icon name="check" size={15} class="mx-auto text-brand" />
                        ) : (
                          <span class="text-mist/25">—</span>
                        )}
                      </td>
                    );
                  })}
                  <td class="border-b border-line/70 px-3 py-4 text-center">
                    {membership.classes_included.length > 0 ? (
                      <Icon name="check" size={15} class="mx-auto text-brand" />
                    ) : (
                      <span class="text-mist/25">—</span>
                    )}
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-4 text-[11px] leading-relaxed text-mist/80">
        Uwaga: karnet „4 strefy + cross” obejmuje zajęcia Cross trening, ale nie strefę Sala cross.
        Karnet „6 stref + zajęcia grupowe” obejmuje oba rodzaje zajęć.
      </p>
    </div>
  </section>

  <!-- Jak zacząć -->
  <section class="border-t border-line bg-ink-2">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <h2 class="eyebrow">Jak zacząć</h2>
      <ol class="mt-8 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="bg-ink-2 p-6">
              <span class="font-mono text-[10px] tracking-[0.2em] text-brand">
                0{i + 1}
              </span>
              <h3 class="mt-4 font-display text-lg font-bold uppercase tracking-tight text-bone">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-mist">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="h2">Pytania o karnety</h2>
          <p class="lead mt-5">
            Najczęstsze wątpliwości. Jeśli czegoś brakuje — zadzwoń, odbierzemy.
          </p>
          <a href={`tel:${contact.phone_e164}`} class="link-arrow mt-6">
            {contact.phone}
            <Icon name="phone" size={14} />
          </a>
        </div>

        <div class="lg:col-span-8">
          <div class="border-t border-line">
            {
              faq.map((item, i) => (
                <details class="group border-b border-line" name="faq">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                    <span class="flex gap-4">
                      <span class="mt-0.5 font-mono text-[10px] tracking-[0.2em] text-mist/80">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span class="font-display text-base font-semibold uppercase leading-snug tracking-tight text-bone transition-colors group-hover:text-brand">
                        {item.q}
                      </span>
                    </span>
                    <Icon
                      name="chevron-down"
                      size={16}
                      class="mt-1 shrink-0 text-mist transition-transform duration-200 group-open:rotate-180"
                    />
                  </summary>
                  <div class="pb-5 pl-10 pr-8 text-sm leading-relaxed text-mist">
                    {item.a}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Nie wiesz, który zakres?"
    text="Zadzwoń albo wpadnij do recepcji — dobierzemy karnet do tego, jak i kiedy trenujesz."
    primary={{ label: "Kontakt i godziny", href: "/kontakt" }}
  />
</BaseLayout>
