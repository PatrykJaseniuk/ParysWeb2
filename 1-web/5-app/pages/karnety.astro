---
import BaseLayout from "../../4-layouts/BaseLayout.astro";
import PageHero from "../../2-ui/ui/PageHero.astro";
import Icon from "../../2-ui/ui/Icon.astro";
import PriceMatrix from "../../3-components/pricing/PriceMatrix.astro";
import CtaBand from "../../3-components/sections/CtaBand.astro";
import {
  clubCardFee,
  contact,
  entryPrice,
  accessCount,
  accesses,
  monthlyFrom,
  variantCount,
  pln,
} from "../../1-data/business";
import { breadcrumbSchema, faqSchema } from "../../2-ui/seo";

const studentMonthly = accesses
  .find((access) => access.id === "acc-4-areas")
  ?.variants.find((variant) => variant.id === "monthly_student_senior");

const faq = [
  {
    q: "Czy muszę podpisywać umowę?",
    a: "Nie. Karnety kupujesz na określony czas — nie podpisujesz umowy lojalnościowej ani zobowiązania na kolejne miesiące.",
  },
  {
    q: "Który karnet obejmuje zajęcia grupowe?",
    a: "Zajęcia grupowe są wliczone w karnet „6 stref + zajęcia grupowe”. Karnet „4 strefy + zajęcia grupowe” również daje dostęp do zajęć grupowych, ale nie do strefy Sala cross.",
  },
  {
    q: "Czym różni się „4 strefy + zajęcia grupowe” od „6 stref + zajęcia grupowe”?",
    a: "„4 strefy + zajęcia grupowe” to cztery strefy treningowe plus zajęcia grupowe. „6 stref + zajęcia grupowe” to wszystkie sześć stref (w tym Sala cross i rollmasaż) oraz zajęcia grupowe.",
  },
  {
    q: "Czy przysługuje mi zniżka jako uczniowi lub seniorowi?",
    a: `Tak, w zakresie „4 strefy” karnet miesięczny kosztuje ${pln(studentMonthly?.price_pln ?? 0)} dla uczniów oraz studentów do 26 roku życia na studiach dziennych i seniorów od 67 roku życia. Wymagane okazanie dokumentu.`,
  },
  {
    q: "Czy wejście jednorazowe wymaga rejestracji?",
    a: `Nie. Wejście jednorazowe do wszystkich stref i zajęć grupowych kosztuje ${pln(entryPrice)} i nie wymaga rejestracji ani karty klubowej. Obowiązuje w godzinach pracy recepcji.`,
  },
  {
    q: "Czy karnet wymaga rejestracji?",
    a: `Tak. Karnet wymaga rejestracji i karty klubowej (${pln(clubCardFee)}), która daje dostęp 24/7.`,
  },
  {
    q: "Czy Pracownicze Karty Sportowe opłacają karnety?",
    a: "Nie. Pracownicze Karty Sportowe pozwalają opłacić wejście jednorazowe do wszystkich stref i zajęć grupowych. Karnet opłacasz bezpośrednio w klubie.",
  },
  {
    q: "Czy MultiSport działa całą dobę?",
    a: "Nie. MultiSport obowiązuje wyłącznie w godzinach pracy recepcji, ponieważ wymaga weryfikacji tożsamości przez pracownika. FitProfit, Medicover i PZU po rejestracji dają dostęp 24/7.",
  },
  {
    q: "Czy FitProfit, Medicover i PZU dają dostęp 24/7?",
    a: `Tak. Po rejestracji otrzymasz fizyczną kartę klubową (${pln(clubCardFee)}), która otwiera bramkę poza godzinami recepcji i pozwala samodzielnie zarejestrować wizytę w terminalu.`,
  },
  {
    q: "Jakie są godziny pracy recepcji?",
    a: `Recepcja: poniedziałek–piątek 8:00–22:00, sobota 9:00–14:00. Karnety dają dostęp 24/7 po rejestracji. W niedziele i święta recepcja jest nieczynna — wejście na kartę klubową.`,
  },
  {
    q: "Czy ceny są aktualne?",
    a: "Tak. Cennik obowiązuje od 1 czerwca 2026 r. Przed zakupem możesz potwierdzić cenę telefonicznie pod numerem 77 433 63 01.",
  },
];

const steps = [
  {
    title: "Przyjdź do recepcji",
    text: "Recepcja jest czynna pon–pt 8:00–22:00 i w sobotę 9:00–14:00. Możesz też zadzwonić wcześniej.",
  },
  {
    title: "Wybierz zakres",
    text: "Cztery strefy, cztery strefy + zajęcia grupowe, pięć stref, sześć stref + zajęcia grupowe albo karnet tylko na rollmasaż — doradzimy na miejscu.",
  },
  {
    title: "Zarejestruj karnet lub wejdź jednorazowo",
    text: `Przy karnecie zarejestruj się i odbierz kartę klubową (${pln(clubCardFee)}), aby wchodzić 24/7. Wejście jednorazowe nie wymaga rejestracji.`,
  },
];
---

<BaseLayout
  title="Karnety i cennik"
  description={`Cennik karnetów Sport Studio Parys w Nysie: 4 strefy, 4 strefy + zajęcia grupowe, 5 stref, 6 stref + zajęcia grupowe oraz karnet 8 wejść na rollmasaż. Wejście od ${pln(entryPrice)}, karnet miesięczny od ${pln(monthlyFrom)}, bez umowy.`}
  canonical="/karnety"
  jsonLd={[
    breadcrumbSchema([{ name: "Karnety", href: "/karnety" }]),
    faqSchema(faq),
  ]}
>
  <PageHero
    index="02"
    label="Karnety"
    title="Cennik karnetów"
    description={`Karnety w ${accessCount} zakresach — ${variantCount} wariantów. Wejście jednorazowe do wszystkich stref i zajęć grupowych kosztuje ${pln(entryPrice)}. Karnety wymagają rejestracji i dają dostęp 24/7, a wejścia jednorazowe nie wymagają rejestracji.`}
    breadcrumbs={[{ name: "Karnety", href: "/karnety" }]}
  >
    <div class="mt-8 flex flex-wrap gap-3">
      <span class="flex items-center gap-2 border border-line px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-bone/70">
        <Icon name="check" size={12} class="text-brand" />
        Bez umowy
      </span>
      <span class="flex items-center gap-2 border border-line px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-bone/70">
        <Icon name="clock" size={12} class="text-brand" />
        Karnety 24/7
      </span>
      <span class="flex items-center gap-2 border border-line px-3 py-2 font-mono text-[10px] uppercase tracking-[0.14em] text-bone/70">
        <Icon name="users" size={12} class="text-brand" />
        Wejścia bez rejestracji
      </span>
    </div>
  </PageHero>

  <!-- Cennik -->
  <section class="bg-bone text-ink">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <PriceMatrix tone="light" scope />

      <div class="mt-12 grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-3">
        <div class="bg-bone p-6">
          <h2 class="font-display text-base font-bold uppercase tracking-tight">Karta klubowa</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-black/60">
            {pln(clubCardFee)} przy rejestracji karnetu. Karta umożliwia wejścia 24/7.
            Wejście jednorazowe nie wymaga rejestracji ani karty.
          </p>
        </div>
        <div class="bg-bone p-6">
          <h2 class="font-display text-base font-bold uppercase tracking-tight">Czas trwania</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-black/60">
            Warianty 2-tygodniowe, miesięczne, 8 wejść i roczne. Karnet roczny
            zawiera dwa miesiące gratis.
          </p>
        </div>
        <div class="bg-bone p-6">
          <h2 class="font-display text-base font-bold uppercase tracking-tight">Pracownicze Karty Sportowe</h2>
          <p class="mt-2 text-[13px] leading-relaxed text-black/60">
            Wejście jednorazowe do wszystkich stref i zajęć grupowych.
            <strong class="font-semibold text-ink">MultiSport</strong> tylko w godzinach recepcji.
            <strong class="font-semibold text-ink">FitProfit</strong>,
            <strong class="font-semibold text-ink">Medicover</strong> i
            <strong class="font-semibold text-ink">PZU</strong> po rejestracji — karta 24/7 i rejestracja wizyty w terminalu.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Jak zacząć -->
  <section class="border-t border-line bg-ink-2">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <h2 class="eyebrow">Jak zacząć</h2>
      <ol class="mt-8 grid gap-px overflow-hidden border border-line bg-line sm:grid-cols-3">
        {
          steps.map((step, i) => (
            <li class="bg-ink-2 p-6">
              <span class="font-mono text-[10px] tracking-[0.2em] text-brand">
                0{i + 1}
              </span>
              <h3 class="mt-4 font-display text-lg font-bold uppercase tracking-tight text-bone">
                {step.title}
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-mist">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- FAQ -->
  <section class="border-t border-line">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-4">
          <h2 class="h2">Pytania o karnety</h2>
          <p class="lead mt-5">
            Najczęstsze wątpliwości. Jeśli czegoś brakuje — zadzwoń, odbierzemy.
          </p>
          <a href={`tel:${contact.phone_e164}`} class="link-arrow mt-6">
            {contact.phone}
            <Icon name="phone" size={14} />
          </a>
        </div>

        <div class="lg:col-span-8">
          <div class="border-t border-line">
            {
              faq.map((item, i) => (
                <details class="group border-b border-line" name="faq">
                  <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                    <span class="flex gap-4">
                      <span class="mt-0.5 font-mono text-[10px] tracking-[0.2em] text-mist-dim">
                        {String(i + 1).padStart(2, "0")}
                      </span>
                      <span class="font-display text-base font-semibold uppercase leading-snug tracking-tight text-bone transition-colors group-hover:text-brand">
                        {item.q}
                      </span>
                    </span>
                    <Icon
                      name="chevron-down"
                      size={16}
                      class="mt-1 shrink-0 text-mist transition-transform duration-200 group-open:rotate-180"
                    />
                  </summary>
                  <div class="pb-5 pl-10 pr-8 text-sm leading-relaxed text-mist">
                    {item.a}
                  </div>
                </details>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Nie wiesz, który zakres?"
    text="Zadzwoń albo wpadnij do recepcji — dobierzemy karnet do tego, jak i kiedy trenujesz."
    primary={{ label: "Kontakt i godziny", href: "/kontakt" }}
  />
</BaseLayout>
