---
import BaseLayout from "../../4-layouts/BaseLayout.astro";
import Icon from "../../2-ui/ui/Icon.astro";
import { contact } from "../../1-data/business";
---

<BaseLayout
  title="Nie znaleziono strony"
  description="Ta strona nie istnieje. Wróć na stronę główną Sport Studio Parys."
  noindex
>
  <section class="container-x flex min-h-[60vh] flex-col justify-center py-20">
    <p class="font-mono text-[10px] uppercase tracking-[0.3em] text-brand">Błąd 404</p>
    <h1 class="mt-6 display text-[clamp(2.6rem,8vw,6rem)]">
      Tej strony<br />nie ma.
    </h1>
    <p class="mt-6 max-w-lg text-base leading-relaxed text-mist">
      Adres mógł się zmienić. Wróć na start albo sprawdź cennik — tam najczęściej
      trafiają osoby, które szukają konkretów.
    </p>

    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/" class="btn-primary">
        Strona główna
        <Icon name="arrow-right" size={15} />
      </a>
      <a href="/karnety" class="btn-ghost">Cennik</a>
      <a href={`tel:${contact.phone_e164}`} class="btn-ghost">
        <Icon name="phone" size={15} />
        <span class="num">{contact.phone}</span>
      </a>
    </div>
  </section>
</BaseLayout>
