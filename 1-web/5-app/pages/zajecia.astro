---
import BaseLayout from "../../4-layouts/BaseLayout.astro";
import PageHero from "../../2-ui/ui/PageHero.astro";
import Icon from "../../2-ui/ui/Icon.astro";
import CalendarEmbed from "../../2-ui/ui/CalendarEmbed.astro";
import CtaBand from "../../3-components/sections/CtaBand.astro";
import { calendarById, contact, groupClasses, personalTraining, pln, trainers } from "../../1-data/business";
import { breadcrumbSchema } from "../../2-ui/seo";

const groupsCalendar = calendarById(groupClasses[0]?.calendar);
---

<BaseLayout
  title="Zajęcia grupowe"
  description="Cross trening i boks w Sport Studio Parys w Nysie. Małe grupy, trener przy każdym uczestniku, harmonogram w kalendarzu online."
  canonical="/zajecia"
  jsonLd={[breadcrumbSchema([{ name: "Zajęcia grupowe", href: "/zajecia" }])]}
>
  <PageHero
    index="04"
    label="Zajęcia grupowe"
    title="Cross trening i boks"
    description="Dwie grupy, małe składy, trener, który widzi każdego. Zajęcia są wliczone w karnet „6 stref + zajęcia grupowe” — Cross trening także w „4 strefy + cross”."
    breadcrumbs={[{ name: "Zajęcia", href: "/zajecia" }]}
  />

  <!-- Harmonogram -->
  <section class="border-b border-line" id="kalendarz">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <h2 class="eyebrow">Harmonogram</h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-mist">
            Aktualne terminy zajęć grupowych. Kalendarz jest publiczny — możesz dodać go do
            własnego Google Calendar.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="#cross-trening" class="link-arrow">Cross trening <Icon name="arrow-down" size={14} /></a>
          <a href="#boks" class="link-arrow">Boks <Icon name="arrow-down" size={14} /></a>
        </div>
      </div>

      {
        groupsCalendar ? (
          <CalendarEmbed
            url={groupsCalendar.url}
            title={groupsCalendar.title ?? "Zajęcia grupowe — harmonogram"}
            description="Wybierz widok tygodnia i sprawdź, kiedy wypadają Twoje zajęcia."
            class="mt-8"
          />
        ) : (
          <p class="mt-8 text-sm text-mist">Harmonogram dostępny w recepcji.</p>
        )
      }
    </div>
  </section>

  <!-- Zajęcia -->
  <section class="divide-y divide-line">
    {
      groupClasses.map((item, index) => {
        const calendar = calendarById(item.calendar);
        return (
          <article id={item.id} class="scroll-mt-28">
            <div class="container-x grid gap-8 py-14 sm:py-16 lg:grid-cols-12 lg:gap-12 lg:py-20">
              <div class:list={["lg:col-span-5", index % 2 === 1 && "lg:order-2"]}>
                <div class="relative overflow-hidden border border-line">
                  <img
                    src="/img/strefy/sala-cross-711.webp"
                    srcset="/img/strefy/sala-cross-500.webp 500w, /img/strefy/sala-cross-711.webp 711w"
                    sizes="(min-width: 1024px) 40vw, 100vw"
                    width="711"
                    height="400"
                    alt={`Zajęcia ${item.name}`}
                    class="aspect-[16/10] w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                  {index === 1 && <div class="absolute inset-0 bg-brand/55 mix-blend-multiply"></div>}
                </div>
              </div>

              <div class:list={["lg:col-span-7", index % 2 === 1 && "lg:order-1"]}>
                <p class="eyebrow">
                  <span class="text-brand">{String(index + 1).padStart(2, "0")}</span>
                  <span class="mx-2 text-mist/80">/</span>
                  zajęcia grupowe
                </p>
                <h2 class="h2 mt-4">{item.name}</h2>
                <p class="mt-6 text-base leading-[1.8] text-bone/80">{item.description}</p>

                <dl class="mt-8 grid gap-px border border-line bg-line sm:grid-cols-2">
                  <div class="bg-ink-2 p-4">
                    <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-mist/80">Prowadzenie</dt>
                    <dd class="mt-1 text-sm text-bone/85">
                      {index === 1 ? "Andrzej — trener boksu" : "trenerzy Parys"}
                    </dd>
                  </div>
                  <div class="bg-ink-2 p-4">
                    <dt class="font-mono text-[9px] uppercase tracking-[0.18em] text-mist/80">W cenie karnetu</dt>
                    <dd class="mt-1 text-sm text-bone/85">
                      {index === 1 ? "6 stref + zajęcia grupowe" : "6 stref + zajęcia, 4 strefy + cross"}
                    </dd>
                  </div>
                </dl>

                <div class="mt-6 flex flex-wrap gap-3">
                  <a href="/karnety" class="btn-primary">Karnet z zajęciami</a>
                  {calendar && (
                    <a href="#kalendarz" class="btn-ghost">
                      <Icon name="calendar" size={14} />
                      Zobacz terminy
                    </a>
                  )}
                </div>
              </div>
            </div>
          </article>
        );
      })
    }
  </section>

  <!-- Trening personalny — skrót -->
  <section class="border-t border-line bg-ink-2">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-end lg:gap-12">
        <div class="lg:col-span-7">
          <h2 class="eyebrow">Wolisz indywidualnie?</h2>
          <p class="h2 mt-4">Trening 1:1</p>
          <p class="lead mt-5 max-w-xl">
            {personalTraining.description} — {trainers.length} trenerów, {pln(personalTraining.price.amount_pln)} za godzinę.
          </p>
        </div>
        <div class="lg:col-span-5 lg:text-right">
          <a href="/trenerzy" class="btn-primary">
            Poznaj trenerów
            <Icon name="arrow-up-right" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand
    title="Przyjdź na pierwszy trening"
    text={`Zapisy i pytania: telefonicznie ${contact.phone} albo w recepcji.`}
    primary={{ label: "Zobacz karnety", href: "/karnety" }}
  />
</BaseLayout>
