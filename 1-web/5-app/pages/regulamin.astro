---
import LegalPage from "../../4-layouts/LegalPage.astro";
import { terms } from "../../1-data/business";
---

<LegalPage title={terms.title} description={terms.description} canonical="/regulamin">
  <p class="font-mono text-[10px] uppercase tracking-[0.16em] text-mist">
    Wersja {terms.version} · obowiązuje od {terms.effective_label}
  </p>

  {
    terms.intro.map((paragraph) => (
      <p class="mt-4 text-sm leading-relaxed text-bone/75">{paragraph}</p>
    ))
  }

  {
    Object.entries(terms.sections).map(([key, section]) => (
      <section id={key}>
        <h2 class="h3 mt-10">{section.title}</h2>
        {section.paragraphs.map((paragraph) => (
          <p class="mt-4 text-sm leading-relaxed text-bone/75">{paragraph}</p>
        ))}
        {section.items.length > 0 && (
          <ul class="mt-4 list-disc space-y-2 pl-5 text-sm leading-relaxed text-bone/75 marker:text-brand">
            {section.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))
  }
</LegalPage>
