---
import BaseLayout from "../../4-layouts/BaseLayout.astro";
import PageHero from "../../2-ui/ui/PageHero.astro";
import Icon from "../../2-ui/ui/Icon.astro";
import CalendarEmbed from "../../2-ui/ui/CalendarEmbed.astro";
import CtaBand from "../../3-components/sections/CtaBand.astro";
import { calendarById, contact, pln, services } from "../../1-data/business";
import { breadcrumbSchema } from "../../2-ui/seo";

const icons = {
  badminton: "shuttle" as const,
  sauna: "flame" as const,
  "bufet-sklep": "cup" as const,
};

function priceLabel(service: (typeof services)[number]) {
  if (!service.price) return "Ceny w sklepie";
  const { amount_pln, unit } = service.price;
  const prefix = unit === "od" ? "od " : "";
  const suffix = unit === "godzina" ? " / godz." : "";
  return `${prefix}${pln(amount_pln)}${suffix}`;
}

const withCalendar = services
  .map((service) => ({ service, calendar: calendarById(service.calendar) }))
  .filter((item) => item.calendar);
---

<BaseLayout
  title="Usługi dodatkowe"
  description="Sauna, badminton i bufet w Sport Studio Parys w Nysie. Ceny, rezerwacje i kalendarze dostępności."
  canonical="/uslugi"
  jsonLd={[breadcrumbSchema([{ name: "Usługi", href: "/uslugi" }])]}
>
  <PageHero
    index="05"
    label="Usługi dodatkowe"
    title="Sauna, badminton i bufet"
    description="Rzeczy, które robią różnicę między „chodzę na siłownię” a „trenuję w klubie”. Rezerwacje przyjmujemy w recepcji i telefonicznie."
    breadcrumbs={[{ name: "Usługi", href: "/uslugi" }]}
  />

  <!-- Karty usług -->
  <section class="container-x py-14 sm:py-16 lg:py-20">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        services.map((service, index) => (
          <article
            id={service.id}
            class="group flex scroll-mt-28 flex-col overflow-hidden border border-line bg-ink-2 transition-colors hover:border-line-soft"
          >
            <div class="relative aspect-[16/10] overflow-hidden bg-ink-3">
              {service.photo ? (
                <img
                  src={service.photo.src}
                  srcset={service.photo.srcset}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  width="1152"
                  height="720"
                  alt={service.photo.alt}
                  class="h-full w-full object-cover grayscale-[0.35] transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                  loading={index < 2 ? "eager" : "lazy"}
                  decoding="async"
                />
              ) : (
                <div class="flex h-full items-center justify-center text-mist/30">
                  <Icon name={icons[service.slug as keyof typeof icons] ?? "spark"} size={32} />
                </div>
              )}
              <div class="absolute inset-0 bg-gradient-to-t from-ink-2/85 via-ink-2/10 to-transparent"></div>
              <span class="absolute left-4 top-4 flex h-11 w-11 items-center justify-center border border-white/15 bg-ink/60 text-brand backdrop-blur transition-colors group-hover:border-brand/50 group-hover:bg-brand/10">
                <Icon name={icons[service.slug as keyof typeof icons] ?? "spark"} size={20} />
              </span>
              <span class="absolute right-4 top-4 font-mono text-[10px] tracking-[0.2em] text-white/70">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <h2 class="font-display text-2xl font-bold uppercase leading-tight tracking-tight text-bone">
                {service.name}
              </h2>
              <p class="mt-1 font-display text-lg font-bold tracking-tight text-brand">
                {priceLabel(service)}
              </p>

              <p class="mt-4 text-sm leading-relaxed text-mist">{service.description}</p>

              {service.booking && (
                <p class="mt-3 flex items-start gap-1.5 font-mono text-[10px] uppercase leading-relaxed tracking-[0.12em] text-bone/55">
                  <Icon name="phone" size={11} class="mt-0.5 shrink-0 text-brand" />
                  {service.booking}
                </p>
              )}

              {service.price?.features && service.price.features.length > 0 && (
                <ul class="mt-4 space-y-1.5">
                  {service.price.features.map((feature) => (
                    <li class="flex items-start gap-2 text-[12px] text-bone/70">
                      <Icon name="check" size={12} class="mt-0.5 shrink-0 text-brand" />
                      {feature}
                    </li>
                  ))}
                </ul>
              )}

              <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-4">
                <p class="font-mono text-[9px] uppercase leading-relaxed tracking-[0.14em] text-mist-dim">
                  {service.booking ? "Rezerwacja" : "Dostępne w recepcji"}
                </p>
                <a href={`tel:${contact.phone_e164}`} class="link-arrow text-[10px]">
                  Rezerwuj
                  <Icon name="phone" size={12} />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-6 font-mono text-[10px] uppercase leading-relaxed tracking-[0.14em] text-mist-dim">
      Rezerwacje prowadzimy telefonicznie pod numerem {contact.phone} lub w recepcji.
    </p>
  </section>

  <!-- Kalendarze -->
  <section class="border-t border-line bg-ink-2" id="kalendarze">
    <div class="container-x py-14 sm:py-16 lg:py-20">
      <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
        <div>
          <h2 class="eyebrow">Dostępność</h2>
          <p class="mt-3 max-w-xl text-sm leading-relaxed text-mist">
            Kalendarze pokazują zajętość sali i sauny. Wybierz termin, a potem potwierdź
            rezerwację telefonicznie.
          </p>
        </div>
        <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-mist-dim">
          Kalendarz Google · ładowany po kliknięciu
        </span>
      </div>

      <div class="mt-8 grid gap-5 lg:grid-cols-2">
        {
          withCalendar.map(({ service, calendar }) => (
            <div>
              <h3 class="font-mono text-[10px] uppercase tracking-[0.2em] text-bone/70">
                {service.name}
              </h3>
              {calendar && (
                <CalendarEmbed
                  url={calendar.url}
                  title={calendar.title ?? `Dostępność — ${service.name}`}
                  class="mt-4"
                />
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="Zarezerwuj termin"
    text="Saunę i kort rezerwujesz telefonicznie lub w recepcji. Kalendarze pokazują aktualną dostępność."
    primary={{ label: "Kontakt", href: "/kontakt" }}
  />
</BaseLayout>
