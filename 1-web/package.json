{
  "name": "parys-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Nowa strona Sport Studio Parys (Nysa) — Astro + Tailwind CSS",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run cms:sync && astro build",
    "preview": "astro preview",
    "check": "npm run cms:check && astro check",
    "model:check": "astro check",
    "model:export": "node 6-tools/export-model.mjs",
    "assets": "python3 6-tools/prepare_assets.py",
    "brand:md": "node 6-tools/export-brand.mjs",
    "lighthouse": "node 6-tools/lighthouse.mjs",
    "cms:sync": "node ../tools/cms/generate.mjs",
    "cms:check": "node ../tools/cms/generate.mjs --check"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.4.1",
    "@fontsource-variable/archivo": "^5.2.6",
    "@fontsource-variable/inter": "^5.2.6",
    "@tailwindcss/vite": "^4.1.11",
    "astro": "^5.12.0",
    "tailwindcss": "^4.1.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "lighthouse": "^12.8.2",
    "typescript": "^5.8.3"
  }
}
