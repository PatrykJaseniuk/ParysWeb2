---
import "@fontsource-variable/archivo/wght.css";
import "@fontsource-variable/inter/wght.css";
import "../2-ui/styles/global.css";

import Header from "../3-components/Header.astro";
import Footer from "../3-components/Footer.astro";
import StickyCta from "../3-components/StickyCta.astro";
import { OG_IMAGE, absoluteUrl, gymSchema, webSiteSchema } from "../2-ui/seo";
import { BASE_PATH, seo, withBase } from "../1-data/business";

interface Props {
  title: string;
  description?: string;
  /** Ścieżka kanoniczna, np. "/karnety". Domyślnie bieżący URL. */
  canonical?: string;
  image?: string;
  noindex?: boolean;
  /** Dodatkowe obiekty JSON-LD (schema.org). */
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}

const {
  title,
  description = seo.description,
  canonical,
  image = OG_IMAGE,
  noindex = false,
  jsonLd = [],
  bodyClass = "",
} = Astro.props;

const currentPath = Astro.url.pathname.startsWith(BASE_PATH)
  ? Astro.url.pathname.slice(BASE_PATH.length) || "/"
  : Astro.url.pathname;
const isHome = currentPath === "/";
const fullTitle = isHome
  ? `${title} — siłownia i klub fitness w Nysie`
  : `${title} — Sport Studio Parys Nysa`;

const canonicalUrl = absoluteUrl(canonical ?? currentPath);
const schemas = [gymSchema(), webSiteSchema(), ...jsonLd];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#0a0a0b" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href={withBase("/brand/icon-192.png")} sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href={withBase("/brand/icon-180.png")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <meta property="og:type" content={isHome ? "website" : "article"} />
    <meta property="og:site_name" content="Sport Studio Parys" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Sport Studio Parys — siłownia w Nysie, czynna całą dobę" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>

  <body class={bodyClass}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:bg-brand focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:uppercase focus:tracking-widest focus:text-white"
    >
      Przejdź do treści
    </a>

    <Header />

    <main id="main">
      <slot />
    </main>

    <Footer />
    <StickyCta />
  </body>
</html>
