---
import Icon from "../2-ui/ui/Icon.astro";
import { business, contact, nav, withBase } from "../1-data/business";

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-ink-2">
  <div class="container-x grid gap-12 py-16 md:grid-cols-12 lg:py-20">
    <!-- Marka -->
    <div class="md:col-span-5 lg:col-span-4">
      <a href={withBase("/")} class="flex items-center gap-3" aria-label="Sport Studio Parys — strona główna">
        <img src={withBase("/brand/icon-mark.svg")} alt="" width="44" height="44" class="h-11 w-11" />
        <span class="leading-none">
          <span class="block font-display text-2xl font-extrabold tracking-[-0.02em]">PARYS</span>
          <span class="mt-1 block font-mono text-[9px] uppercase tracking-[0.24em] text-mist">
            siłownia / cross
          </span>
        </span>
      </a>

      <p class="mt-6 max-w-sm text-sm leading-relaxed text-mist">
        {business.shortDescription}
      </p>

      <div class="mt-6 flex items-center gap-2">
        {
          contact.social.map((social) => (
            <a
              href={social.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex h-10 w-10 items-center justify-center border border-line text-bone/70 transition-colors hover:border-brand hover:text-brand"
              aria-label={`${social.platform} — ${social.handle}`}
            >
              <Icon name={social.platform === "Facebook" ? "facebook" : "instagram"} size={17} />
            </a>
          ))
        }
      </div>
    </div>

    <!-- Nawigacja -->
    <nav class="md:col-span-3 lg:col-span-2" aria-label="Nawigacja w stopce">
      <h2 class="font-mono text-[10px] uppercase tracking-[0.28em] text-mist">Strona</h2>
      <ul class="mt-5 space-y-3">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-bone/80 transition-colors hover:text-brand">
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Kontakt -->
    <div class="md:col-span-4 lg:col-span-3">
      <h2 class="font-mono text-[10px] uppercase tracking-[0.28em] text-mist">Kontakt</h2>
      <ul class="mt-5 space-y-4 text-sm">
        <li class="flex gap-3">
          <Icon name="pin" size={16} class="mt-0.5 shrink-0 text-brand" />
          <a
            href={`https://www.google.com/maps/search/?api=1&query=${contact.coordinates.lat},${contact.coordinates.lng}`}
            target="_blank"
            rel="noopener noreferrer"
            class="text-bone/80 transition-colors hover:text-bone"
          >
            {contact.address.street}<br />{contact.address.postal_code} {contact.address.city}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="phone" size={16} class="mt-0.5 shrink-0 text-brand" />
          <a href={`tel:${contact.phone_e164}`} class="num text-bone/80 transition-colors hover:text-bone">
            {contact.phone}
          </a>
        </li>
        <li class="flex gap-3">
          <Icon name="mail" size={16} class="mt-0.5 shrink-0 text-brand" />
          <a href={`mailto:${contact.email}`} class="break-all text-bone/80 transition-colors hover:text-bone">
            {contact.email}
          </a>
        </li>
      </ul>
    </div>

    <!-- Godziny -->
    <div class="md:col-span-12 lg:col-span-3">
      <h2 class="font-mono text-[10px] uppercase tracking-[0.28em] text-mist">Godziny</h2>
      <div class="mt-5 border border-line bg-ink p-4">
        <p class="flex items-center justify-between font-mono text-[11px] uppercase tracking-[0.14em]">
          <span class="text-bone">Klub</span>
          <span class="text-brand">24/7</span>
        </p>
        <div class="mt-3 space-y-2 border-t border-line pt-3">
          {
            contact.reception_hours.map((row) => (
              <p class="flex items-center justify-between text-xs text-mist">
                <span>Recepcja {row.days}</span>
                <span class="num text-bone/80">
                  {row.open}–{row.close}
                </span>
              </p>
            ))
          }
        </div>
      </div>
      <p class="mt-3 text-[11px] leading-relaxed text-mist/70">
        Klub czynny całą dobę — wejście poza godzinami recepcji na kartę klubową.
      </p>
    </div>
  </div>

  <div class="border-t border-line">
    <div
      class="container-x flex flex-col gap-3 py-6 font-mono text-[10px] uppercase tracking-[0.16em] text-mist/70 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} Sport Studio Parys · Nysa</p>
      <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={withBase("/polityka-prywatnosci")} class="transition-colors hover:text-bone">Polityka prywatności</a>
        <a href={withBase("/regulamin")} class="transition-colors hover:text-bone">Regulamin</a>
        <span class="text-mist/80">Ceny brutto · stan na {new Date().getFullYear()}</span>
      </div>
    </div>
  </div>
</footer>
