---
import Icon from "../../2-ui/ui/Icon.astro";
import {
  VARIANT_ORDER,
  areas,
  buildMatrix,
  clubCardFee,
  accesses,
  pln,
  singleEntry,
  withBase,
} from "../../1-data/business";

interface Props {
  /** Cennik na ciemnym tle (domyślnie) albo na „papierze”. */
  tone?: "dark" | "light";
  /** Czy pod cenami pokazać zakres stref i zajęć przypisanych do karnetu. */
  scope?: boolean;
}

const { tone = "dark", scope = false } = Astro.props;
const { rows } = buildMatrix();

/** Karnet wyróżniony pochodzi z modelu (`featured`), nie z nazwy id. */
const isFeatured = (access: (typeof accesses)[number]) => access.featured;

const themeVars =
  tone === "light"
    ? [
        "--pm-text:#0a0a0b",
        "--pm-muted:#5f5f66",
        "--pm-faint:#a2a2a8",
        "--pm-line:rgba(10,10,11,0.16)",
        "--pm-line-soft:rgba(10,10,11,0.09)",
        "--pm-surface:#fbfaf8",
        "--pm-hover:rgba(10,10,11,0.035)",
        "--pm-featured:rgba(227,30,36,0.055)",
        "--pm-featured-hover:rgba(227,30,36,0.09)",
      ].join(";")
    : [
        "--pm-text:#f2f1ed",
        "--pm-muted:#9d9da5",
        "--pm-faint:#4a4a52",
        "--pm-line:rgba(255,255,255,0.12)",
        "--pm-line-soft:rgba(255,255,255,0.07)",
        "--pm-surface:#101012",
        "--pm-hover:rgba(255,255,255,0.025)",
        "--pm-featured:rgba(227,30,36,0.06)",
        "--pm-featured-hover:rgba(227,30,36,0.1)",
      ].join(";");

const variantLabel = (id: string, label: string) =>
  id === "monthly_student_senior" ? "Miesiąc (uczeń/senior)" : label.charAt(0) + label.slice(1).toLowerCase();

const cellClass = (access: (typeof accesses)[number]) =>
  [
    "border-b border-[color:var(--pm-line-soft)] px-5 py-4 align-middle transition-colors group-hover:bg-[color:var(--pm-hover)]",
    isFeatured(access) && "bg-[color:var(--pm-featured)] group-hover:bg-[color:var(--pm-featured-hover)]",
  ];
---

<div style={themeVars} class="text-[color:var(--pm-text)]">
  <!-- ============ WEJŚCIE JEDNORAZOWE ============ -->
  <div class="mb-8 flex flex-col gap-4 border border-[color:var(--pm-line)] bg-[color:var(--pm-surface)] p-5 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-mono text-[9px] uppercase tracking-[0.22em] text-[color:var(--pm-muted)]">
        Poza karnetem
      </p>
      <p class="mt-1 font-display text-lg font-bold uppercase tracking-tight">
        {singleEntry.name}
      </p>
      <p class="mt-1 text-[12px] leading-relaxed text-[color:var(--pm-muted)]">
        {singleEntry.description} · ważne {singleEntry.validity}
      </p>
    </div>
    <p class="shrink-0 sm:text-right">
      <span class="num block font-display text-3xl font-extrabold tracking-tight text-brand">
        {pln(singleEntry.price_pln)}
      </span>
      <span class="mt-0.5 block font-mono text-[9px] uppercase tracking-[0.16em] text-[color:var(--pm-muted)]">
        za wejście
      </span>
    </p>
  </div>

  <!-- ============ DESKTOP: macierz ============ -->
  <div class="hidden lg:block">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[900px] border-collapse text-left">
        <caption class="sr-only">
          Porównanie karnetów Sport Studio Parys — warianty, ceny i zakres stref
        </caption>

        <thead>
          <tr>
            <th scope="col" class="w-[24%] border-b border-[color:var(--pm-line)] px-5 pb-6 pt-2 align-top">
              <span class="font-mono text-[10px] uppercase tracking-[0.3em] text-[color:var(--pm-muted)]">Wariant</span>
            </th>
            {
              accesses.map((access, i) => (
                <th
                  scope="col"
                  class:list={[
                    "border-b border-[color:var(--pm-line)] px-5 pb-6 pt-2 align-top text-left",
                    isFeatured(access) && "border-t-2 border-t-brand bg-[color:var(--pm-featured)]",
                  ]}
                >
                  <div class="flex h-[18px] items-center justify-between gap-2">
                    <span class="font-mono text-[10px] tracking-[0.2em] text-[color:var(--pm-faint)]">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    {isFeatured(access) && (
                      <span class="bg-brand px-2 py-0.5 font-mono text-[8px] font-semibold uppercase tracking-[0.16em] text-white">
                        Pełny zakres
                      </span>
                    )}
                  </div>
                  <span class="mt-3 block min-h-[2.625rem] font-display text-xl font-bold uppercase leading-[1.05] tracking-tight">
                    {access.name}
                  </span>
                  <span class="mt-1.5 block min-h-[2rem] text-[11px] leading-snug text-[color:var(--pm-muted)]">
                    {access.subtitle ?? `${access.areas_included.length} strefy treningowe`}
                  </span>
                </th>
              ))
            }
          </tr>
        </thead>

        <tbody>
          {
            rows.map((row, rowIndex) => (
              <tr class="group">
                <th
                  scope="row"
                  class:list={[
                    "border-b border-[color:var(--pm-line-soft)] px-5 py-4 align-middle font-normal",
                    rowIndex === 0 && "pt-5",
                  ]}
                >
                  <span class="block font-display text-sm font-semibold uppercase tracking-tight">
                    {row.meta.label}
                  </span>
                  <span class="mt-0.5 block text-[11px] leading-snug text-[color:var(--pm-muted)]">
                    {row.meta.description}
                  </span>
                </th>

                {row.cells.map((cell, cellIndex) => (
                  <td class:list={cellClass(accesses[cellIndex])}>
                    {cell ? (
                      <span class="num font-display text-xl font-bold tracking-tight">
                        {pln(cell.price)}
                      </span>
                    ) : (
                      <span class="font-mono text-sm text-[color:var(--pm-faint)]" aria-label="niedostępne">
                        —
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))
          }

          {
            scope && (
              <>
                <tr>
                  <th
                    scope="colgroup"
                    colspan={accesses.length + 1}
                    class="border-b border-[color:var(--pm-line)] px-5 pb-2 pt-8 text-left font-mono text-[10px] uppercase tracking-[0.3em] text-[color:var(--pm-muted)]"
                  >
                    Zakres
                  </th>
                </tr>

                {areas.map((area) => (
                  <tr class="group">
                    <th scope="row" class="border-b border-[color:var(--pm-line-soft)] px-5 py-3 align-middle font-normal">
                      <a
                        href={withBase(`/strefy/${area.slug}`)}
                        class="block font-display text-sm font-semibold uppercase tracking-tight underline decoration-[color:var(--pm-muted)] underline-offset-2 transition-colors hover:text-brand"
                      >
                        {area.name}
                      </a>
                    </th>
                    {accesses.map((access, cellIndex) => {
                      const included = access.areas_included.includes(area.id);
                      return (
                        <td class:list={cellClass(accesses[cellIndex])}>
                          {included ? (
                            <Icon name="check" size={15} class="text-brand" />
                          ) : (
                            <span class="font-mono text-sm text-[color:var(--pm-faint)]" aria-label="nie obejmuje">
                              —
                            </span>
                          )}
                        </td>
                      );
                    })}
                  </tr>
                ))}

                <tr class="group">
                  <th scope="row" class="border-b border-[color:var(--pm-line-soft)] px-5 py-3 align-middle font-normal">
                    <a
                      href={withBase("/zajecia")}
                      class="block font-display text-sm font-semibold uppercase tracking-tight underline decoration-[color:var(--pm-muted)] underline-offset-2 transition-colors hover:text-brand"
                    >
                      Zajęcia grupowe
                    </a>
                  </th>
                  {accesses.map((access, cellIndex) => {
                    const included = access.classes_included.length > 0;
                    return (
                      <td class:list={cellClass(accesses[cellIndex])}>
                        {included ? (
                          <Icon name="check" size={15} class="text-brand" />
                        ) : (
                          <span class="font-mono text-sm text-[color:var(--pm-faint)]" aria-label="nie obejmuje">
                            —
                          </span>
                        )}
                      </td>
                    );
                  })}
                </tr>
              </>
            )
          }
        </tbody>
      </table>
    </div>

    <p class="mt-6 border-t border-[color:var(--pm-line)] pt-4 font-mono text-[10px] uppercase leading-relaxed tracking-[0.14em] text-[color:var(--pm-muted)]">
      Karnety wymagają rejestracji i karty klubowej ({pln(clubCardFee)}) · wejścia jednorazowe
      nie wymagają rejestracji · brak umowy lojalnościowej
    </p>
  </div>

  <!-- ============ MOBILE: karty ============ -->
  <div class="space-y-4 lg:hidden">
    {
      accesses.map((access, i) => (
        <article
          class:list={[
            "border bg-[color:var(--pm-surface)]",
            isFeatured(access) ? "border-brand/60" : "border-[color:var(--pm-line)]",
          ]}
        >
          <header class="flex items-start justify-between gap-3 p-5 pb-4">
            <div>
              <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-[color:var(--pm-faint)]">
                {String(i + 1).padStart(2, "0")}
                {isFeatured(access) && <span class="ml-2 text-brand">· pełny zakres</span>}
              </p>
              <h3 class="mt-1.5 font-display text-xl font-bold uppercase leading-tight tracking-tight">
                {access.name}
              </h3>
              <p class="mt-1 text-[11px] leading-snug text-[color:var(--pm-muted)]">
                {access.subtitle ?? `${access.areas_included.length} strefy treningowe`}
              </p>
            </div>
            <p class="shrink-0 text-right">
              <span class="block font-mono text-[9px] uppercase tracking-[0.16em] text-[color:var(--pm-muted)]">od</span>
              <span class="num block font-display text-2xl font-extrabold tracking-tight text-brand">
                {pln(access.fromPrice)}
              </span>
            </p>
          </header>

          <dl class="divide-y divide-[color:var(--pm-line-soft)] border-t border-[color:var(--pm-line-soft)]">
            {[...access.variants]
              .sort(
                (a, b) => VARIANT_ORDER.indexOf(a.id as never) - VARIANT_ORDER.indexOf(b.id as never),
              )
              .map((variant) => (
              <div class="flex items-baseline justify-between gap-4 px-5 py-2.5">
                <dt class="text-[13px] opacity-80">{variantLabel(variant.id, variant.label)}</dt>
                <dd class="num shrink-0 font-display text-base font-semibold">
                  {pln(variant.price_pln)}
                </dd>
              </div>
            ))}
          </dl>

          {scope && (
            <div class="border-t border-[color:var(--pm-line-soft)] px-5 py-3">
              <p class="font-mono text-[9px] uppercase tracking-[0.2em] text-[color:var(--pm-faint)]">
                Zakres
              </p>
              <ul class="mt-2 flex flex-wrap gap-x-3 gap-y-1 text-[11px] leading-snug text-[color:var(--pm-muted)]">
                {areas
                  .filter((area) => access.areas_included.includes(area.id))
                  .map((area) => (
                    <li class="flex items-center gap-1">
                      <Icon name="check" size={11} class="shrink-0 text-brand" />
                      <a href={withBase(`/strefy/${area.slug}`)} class="underline decoration-[color:var(--pm-muted)] underline-offset-2 transition-colors hover:text-brand">
                        {area.name}
                      </a>
                    </li>
                  ))}
                {access.classes_included.length > 0 && (
                  <li class="flex items-center gap-1">
                    <Icon name="check" size={11} class="shrink-0 text-brand" />
                    <a href={withBase("/zajecia")} class="underline decoration-[color:var(--pm-muted)] underline-offset-2 transition-colors hover:text-brand">
                      Zajęcia grupowe
                    </a>
                  </li>
                )}
              </ul>
            </div>
          )}
        </article>
      ))
    }

    <p class="pt-1 font-mono text-[10px] uppercase leading-relaxed tracking-[0.14em] text-[color:var(--pm-muted)]">
      Karnety: rejestracja i karta klubowa {pln(clubCardFee)} · wejścia jednorazowe bez rejestracji · bez umowy lojalnościowej
    </p>
  </div>
</div>
