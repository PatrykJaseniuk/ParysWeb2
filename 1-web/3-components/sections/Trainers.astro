---
import Icon from "../../2-ui/ui/Icon.astro";
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import { contact, personalTraining, trainers, withBase } from "../../1-data/business";
---

<section class="border-t border-black/10 bg-bone text-ink" id="trenerzy">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <SectionHead
      index="04"
      label="Trening personalny"
      title="Trener, który zna Twój plan"
      description={`${personalTraining.description}. Praca 1:1 — technika, progresja i tempo dopasowane do Ciebie, nie do grupy.`}
      tone="light"
    />

    <div class="mt-10 grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {
        trainers.map((trainer, i) => (
          <article class="group flex flex-col bg-bone p-6 sm:last:col-span-2 lg:last:col-span-2 xl:last:col-span-1">
            <div class="flex items-start justify-between">
              <span class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-full bg-ink ring-1 ring-black/10">
                {trainer.photo ? (
                  <img
                    src={trainer.photo.src}
                    alt={trainer.photo.alt}
                    width="150"
                    height="150"
                    class="h-full w-full object-cover"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <span class="font-display text-2xl font-extrabold uppercase text-bone">
                    {trainer.name.charAt(0)}
                  </span>
                )}
              </span>
              <span class="font-mono text-[10px] tracking-[0.2em] text-black/30">
                {String(i + 1).padStart(2, "0")}
              </span>
            </div>

            <h3 class="mt-6 font-display text-xl font-bold uppercase tracking-tight">{trainer.name}</h3>
            <p class="mt-1 text-sm leading-relaxed text-black/55">{trainer.description}</p>

            {
              trainer.specialties.length > 0 && (
                <ul class="mt-3 flex flex-wrap gap-1.5">
                  {trainer.specialties.map((specialty) => (
                    <li class="border border-black/15 px-2 py-1 font-mono text-[9px] uppercase leading-none tracking-[0.12em] text-black/55">
                      {specialty}
                    </li>
                  ))}
                </ul>
              )
            }

            {
              trainer.instagram && (
                <a
                  href={trainer.instagram}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-3 inline-flex w-fit items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.14em] text-black/60 transition-colors hover:text-brand"
                  aria-label={`Instagram — ${trainer.name}`}
                >
                  <Icon name="instagram" size={13} />
                  Instagram
                </a>
              )
            }

            <div class="mt-auto pt-6">
              <div class="flex items-center gap-2 border-t border-black/10 pt-4 font-mono text-[10px] uppercase tracking-[0.14em] text-black/45">
                <Icon name="barbell" size={13} class="text-brand" />
                Trening 1:1
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-5 border-t border-black/15 pt-8 sm:flex-row sm:items-center">
      <p class="max-w-md text-sm leading-relaxed text-black/55">
        {personalTraining.booking}
      </p>

      <div class="flex flex-wrap gap-3">
        <a href={`tel:${contact.phone_e164}`} class="btn-light">
          <Icon name="phone" size={15} />
          Umów trening
        </a>
        <a href={withBase("/trenerzy")} class="link-arrow self-center text-ink">
          Więcej o trenerach
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </div>
  </div>
</section>
