---
import Icon from "../../2-ui/ui/Icon.astro";
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import { groupClasses, calendarById, withBase } from "../../1-data/business";
---

<section class="border-b border-line bg-ink" id="zajecia">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <SectionHead
      index="03"
      label="Zajęcia grupowe"
      title="Dwie grupy, jeden prowadzący, zero tłoku"
      description="Cross trening i boks w małych grupach — trener ogarnia technikę każdego uczestnika, a nie tylko pierwszy rząd."
      link={{ label: "Terminy i kalendarz", href: withBase("/zajecia") }}
    />

    <div class="mt-10 grid gap-4 lg:grid-cols-2 lg:gap-6">
      {
        groupClasses.map((item, i) => {
          const calendar = calendarById(item.calendar);
          const photo = "sala-cross";
          return (
            <article class="group flex flex-col border border-line bg-ink-2">
              <a href={`${withBase("/zajecia")}#${item.id}`} class="relative block aspect-[16/9] overflow-hidden">
                <img
                  src={withBase(`/img/strefy/${photo}-711.webp`)}
                  srcset={`${withBase(`/img/strefy/${photo}-500.webp`)} 500w, ${withBase(`/img/strefy/${photo}-711.webp`)} 711w`}
                  sizes="(min-width: 1024px) 46vw, 100vw"
                  alt={`Zajęcia grupowe: ${item.name}`}
                  width="711"
                  height="400"
                  class="h-full w-full object-cover grayscale-[0.35] transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-2 via-ink-2/20 to-transparent"></div>
                {i === 1 && <div class="absolute inset-0 bg-brand/55 mix-blend-multiply"></div>}
                <span class="absolute left-4 top-4 bg-brand px-2.5 py-1 font-mono text-[9px] font-semibold uppercase tracking-[0.18em] text-white">
                  {i === 0 ? "Nowi w cross" : "Sztuki walki"}
                </span>
              </a>

              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <div class="flex items-baseline justify-between gap-3">
                  <h3 class="font-display text-2xl font-bold uppercase tracking-tight text-bone">
                    {item.name}
                  </h3>
                  <span class="font-mono text-[10px] uppercase tracking-[0.16em] text-mist/75">
                    grupa
                  </span>
                </div>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-mist">
                  {item.summary}
                </p>

                <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
                  {calendar ? (
                    <span class="flex items-center gap-2 font-mono text-[10px] uppercase tracking-[0.14em] text-mist">
                      <Icon name="calendar" size={13} class="text-brand" />
                      {calendar.title ?? "Harmonogram tygodnia"}
                    </span>
                  ) : (
                    <span class="font-mono text-[10px] uppercase tracking-[0.14em] text-mist">Zapisy w recepcji</span>
                  )}
                  <a href={`${withBase("/zajecia")}#${item.id}`} class="link-arrow">
                    Szczegóły
                    <Icon name="arrow-up-right" size={14} />
                  </a>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>
