---
import Icon from "../../2-ui/ui/Icon.astro";
import { contact, withBase } from "../../1-data/business";

interface Props {
  title?: string;
  text?: string;
  primary?: { label: string; href: string };
}

const {
  title = "Gotowy na pierwszy trening?",
  text = "Przyjdź w godzinach pracy recepcji — pokażemy Ci klub, wytłumaczymy karnety i pomożemy wybrać zakres.",
  primary = { label: "Zobacz karnety", href: withBase("/karnety") },
} = Astro.props;
---

<section class="border-t border-line bg-ink-2">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-end">
      <div class="max-w-2xl">
        <p class="eyebrow"><span class="text-brand-text-dark">—</span> Zapraszamy</p>
        <h2 class="h2 mt-4">{title}</h2>
        <p class="lead mt-5">{text}</p>
      </div>

      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={primary.href} class="btn-primary justify-center">
          {primary.label}
          <Icon name="arrow-up-right" size={15} />
        </a>
        <a href={`tel:${contact.phone_e164}`} class="btn-ghost justify-center">
          <Icon name="phone" size={15} />
          <span class="num">{contact.phone}</span>
        </a>
      </div>
    </div>
  </div>
</section>
