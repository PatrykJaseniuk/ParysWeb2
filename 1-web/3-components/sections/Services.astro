---
import Icon from "../../2-ui/ui/Icon.astro";
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import { contact, pln, services, withBase } from "../../1-data/business";

function priceLabel(service: (typeof services)[number]) {
  if (!service.price) return "Ceny w sklepie";
  const { amount_pln, unit } = service.price;
  const prefix = unit === "od" ? "od " : "";
  const suffix = unit === "godzina" ? " / godz." : "";
  return `${prefix}${pln(amount_pln)}${suffix}`;
}
---

<section class="border-t border-line bg-ink" id="uslugi">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <SectionHead
      index="05"
      label="Usługi dodatkowe"
      title="Nie tylko siłownia"
      description="Sauna, badminton i bufet — rzeczy, które robią różnicę między „chodzę na siłownię” a „trenuję w klubie”."
      link={{ label: "Wszystkie usługi", href: withBase("/uslugi") }}
    />

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 lg:gap-5">
      {
        services.map((service, i) => (
          <article class="group relative flex flex-col overflow-hidden border border-line bg-ink-2 transition-colors hover:border-line-soft">
            {service.photo && (
              <a
                href={`${withBase("/uslugi")}#${service.id}`}
                class="relative block aspect-[16/10] overflow-hidden bg-ink-3"
                aria-label={`${service.name} — szczegóły`}
              >
                <img
                  src={service.photo.src}
                  srcset={service.photo.srcset}
                  sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 100vw"
                  width="1152"
                  height="720"
                  alt={service.photo.alt}
                  class="h-full w-full object-cover grayscale-[0.35] transition-all duration-500 group-hover:scale-[1.02] group-hover:grayscale-0"
                  loading="lazy"
                  decoding="async"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-ink-2/80 via-ink-2/10 to-transparent"></div>
                <span class="absolute left-3 top-3 border border-white/15 bg-ink/70 px-2 py-1 font-mono text-[9px] uppercase tracking-[0.18em] text-white/80 backdrop-blur">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </a>
            )}

            <div class="flex flex-1 flex-col p-6 sm:p-7">
              <div class="flex items-start justify-between gap-4">
                <h3 class="font-display text-xl font-bold uppercase leading-tight tracking-tight text-bone sm:text-2xl">
                  {service.name}
                </h3>
                <p class="shrink-0 text-right">
                  <span class="num block font-display text-lg font-bold text-brand-text-dark sm:text-xl">
                    {priceLabel(service)}
                  </span>
                </p>
              </div>

              <p class="mt-4 text-sm leading-relaxed text-mist">{service.description}</p>

              {service.booking && (
                <p class="mt-3 flex items-start gap-1.5 font-mono text-[10px] uppercase leading-relaxed tracking-[0.12em] text-bone/55">
                  <Icon name="phone" size={11} class="mt-0.5 shrink-0 text-brand" />
                  {service.booking}
                </p>
              )}

              <div class="mt-auto flex items-center justify-between gap-3 border-t border-line pt-4">
                <span class="font-mono text-[10px] uppercase leading-relaxed tracking-[0.12em] text-mist-dim">
                  {service.booking ? "Rezerwacja" : "Kontakt"}
                </span>
                <div class="flex items-center gap-4">
                  {service.calendar && (
                    <a href={withBase("/uslugi")} class="link-arrow text-[10px]">
                      Kalendarz
                      <Icon name="calendar" size={12} />
                    </a>
                  )}
                  <a href={`tel:${contact.phone_e164}`} class="link-arrow text-[10px]">
                    Rezerwuj
                    <Icon name="phone" size={12} />
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <p class="mt-6 font-mono text-[10px] uppercase leading-relaxed tracking-[0.14em] text-mist-dim">
      Rezerwacje sauny i badmintona prowadzimy telefonicznie: {contact.phone}
    </p>
  </div>
</section>
