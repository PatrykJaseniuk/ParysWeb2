---
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import { partners } from "../../1-data/business";
---

<section class="border-t border-line bg-ink-2" id="partnerzy">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-5">
        <SectionHead
          index="06"
          label="Pracownicze Karty Sportowe"
          title="Akceptujemy karty sportowe"
          description="MultiSport, Medicover Sport, FitProfit i PZU. Możesz opłacić kartą wizytę jednorazową do wszystkich stref i zajęć grupowych."
        />

        <p class="mt-6 font-mono text-[10px] uppercase tracking-[0.14em] text-mist-dim">
          Inna karta? Zapytaj w recepcji
        </p>
      </div>

      <div class="lg:col-span-7">
        <ul class="border-t border-line">
          {
            partners.map((partner) => (
              <li class="flex items-center gap-4 border-b border-line py-4">
                <span class="flex h-12 w-24 shrink-0 items-center justify-center bg-white px-2">
                  {partner.logoSrc ? (
                    <img
                      src={partner.logoSrc}
                      alt={`Logo ${partner.name}`}
                      class="max-h-8 w-auto max-w-full object-contain"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <span class="font-display text-[11px] font-bold uppercase tracking-tight text-ink">
                      {partner.name}
                    </span>
                  )}
                </span>

                <div class="min-w-0">
                  <p class="font-display text-sm font-semibold uppercase tracking-tight text-bone">
                    {partner.name}
                  </p>
                  <p class="mt-0.5 text-[12px] leading-relaxed text-mist">{partner.note}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
