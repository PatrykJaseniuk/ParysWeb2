---
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import Icon from "../../2-ui/ui/Icon.astro";
import MapEmbed from "../../2-ui/ui/MapEmbed.astro";
import { business, contact, facilities } from "../../1-data/business";

const parking = facilities.find((facility) => facility.id === "hl-parking");
---

<section class="border-t border-line bg-ink" id="kontakt">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <SectionHead
      index="07"
      label="Kontakt"
      title="Tu trenujemy"
      description="Recepcja czynna od poniedziałku do soboty. Z karnetem wchodzisz o dowolnej porze — także w niedzielę i w święta."
    />

    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-8">
      <!-- Dane -->
      <div class="lg:col-span-5">
        <div class="border-t border-line">
          <a
            href={`tel:${contact.phone_e164}`}
            class="group flex items-center justify-between border-b border-line py-5"
          >
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mist">Telefon</p>
              <p class="num mt-1 font-display text-2xl font-bold tracking-tight text-bone transition-colors group-hover:text-brand sm:text-3xl">
                {contact.phone}
              </p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center border border-line text-mist transition-colors group-hover:border-brand group-hover:bg-brand group-hover:text-white">
              <Icon name="phone" size={16} />
            </span>
          </a>

          <a
            href={`mailto:${contact.email}`}
            class="group flex items-center justify-between border-b border-line py-5"
          >
            <div class="min-w-0">
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mist">E-mail</p>
              <p class="mt-1 truncate text-base text-bone transition-colors group-hover:text-brand">
                {contact.email}
              </p>
            </div>
            <span class="flex h-10 w-10 shrink-0 items-center justify-center border border-line text-mist transition-colors group-hover:border-brand group-hover:bg-brand group-hover:text-white">
              <Icon name="mail" size={16} />
            </span>
          </a>

          <div class="flex items-start justify-between border-b border-line py-5">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mist">Adres</p>
              <p class="mt-1 text-base leading-relaxed text-bone">
                {contact.address.street}<br />
                {contact.address.postal_code} {contact.address.city}
              </p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center border border-line text-mist">
              <Icon name="pin" size={16} />
            </span>
          </div>

          {parking && (
            <div class="flex items-start justify-between border-b border-line py-5">
              <div>
                <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mist">{parking.title}</p>
                <p class="mt-1 text-base leading-relaxed text-bone">{parking.description}</p>
              </div>
              <span class="flex h-10 w-10 items-center justify-center border border-line text-mist">
                <Icon name="parking" size={16} />
              </span>
            </div>
          )}

          <div class="flex items-start justify-between border-b border-line py-5">
            <div>
              <p class="font-mono text-[10px] uppercase tracking-[0.22em] text-mist">Recepcja</p>
              <ul class="mt-1 space-y-1">
                {
                  contact.reception_hours.map((row) => (
                    <li class="flex items-baseline gap-3 text-sm text-bone/85">
                      <span class="w-16 font-mono text-[11px] uppercase tracking-[0.1em] text-mist">
                        {row.days}
                      </span>
                      <span class="num">
                        {row.open}–{row.close}
                      </span>
                    </li>
                  ))
                }
              </ul>
              <p class="mt-2 font-mono text-[10px] uppercase tracking-[0.12em] text-mist/80">
                {business.open24 ? "Klub 24/7 dla karnetów" : ""}
              </p>
            </div>
            <span class="flex h-10 w-10 items-center justify-center border border-line text-mist">
              <Icon name="clock" size={16} />
            </span>
          </div>
        </div>

        <div class="mt-6 flex items-center gap-2">
          {
            contact.social.map((social) => (
              <a
                href={social.url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 items-center gap-2 border border-line px-3 text-bone/70 transition-colors hover:border-brand hover:text-brand"
              >
                <Icon name={social.platform === "Facebook" ? "facebook" : "instagram"} size={14} />
                <span class="font-mono text-[10px] uppercase tracking-[0.14em]">{social.handle}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Mapa -->
      <MapEmbed
        class="lg:col-span-7"
        lat={contact.coordinates.lat}
        lng={contact.coordinates.lng}
        embedUrl={contact.mapEmbed}
        placeName={contact.placeName}
        addressLine1={contact.address.street}
        addressLine2={`${contact.address.postal_code} ${contact.address.city}`}
      />
    </div>
  </div>
</section>
