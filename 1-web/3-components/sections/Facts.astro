---
import Icon from "../../2-ui/ui/Icon.astro";
import type { IconName } from "../../2-ui/icons";
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import { business, facilities, partners } from "../../1-data/business";

const iconMap: Record<string, IconName> = {
  IconClockShield: "clock",
  IconBarbell: "barbell",
  IconSquare: "area",
  IconAirConditioning: "snowflake",
  IconHeartHandshake: "users",
  IconParking: "parking",
};

const partnerNames = partners.map((p) => p.name === "Medicover Sport" ? "Medicover" : p.name);
---

<section class="container-x py-14 sm:py-16 lg:py-20" id="klub">
  <SectionHead
    index="01"
    label="Klub"
    title="Wszystko, czego potrzebujesz"
    description={`${business.area} m² w sześciu klimatyzowanych salach, sprzęt sprawdzonych marek i wejście na kartę przez całą dobę.`}
  />

  <ul class="mt-10 grid border-l border-t border-line sm:grid-cols-2 lg:grid-cols-3">
    {
      facilities.map((facility, i) => (
        <li class="group relative flex flex-col gap-4 border-b border-r border-line p-6 transition-colors hover:bg-ink-2 sm:p-7 lg:p-8">
          <div class="flex items-start justify-between">
            <span class="flex h-11 w-11 items-center justify-center border border-line text-brand transition-colors group-hover:border-brand/50 group-hover:bg-brand/10">
              <Icon name={iconMap[facility.icon_hint] ?? "spark"} size={20} />
            </span>
            <span class="font-mono text-[10px] tracking-[0.2em] text-mist/80">
              {String(i + 1).padStart(2, "0")}
            </span>
          </div>

          <div>
            <h3 class="font-display text-xl font-bold uppercase tracking-tight text-bone">
              {facility.title}
            </h3>
            {facility.description && (
              <p class="mt-2 text-sm leading-relaxed text-mist">{facility.description}</p>
            )}
          </div>

          {facility.icon_hint === "IconHeartHandshake" && (
            <p class="mt-auto font-mono text-[10px] uppercase leading-relaxed tracking-[0.14em] text-bone/60">
              {partnerNames.join(" · ")}
            </p>
          )}
        </li>
      ))
    }
  </ul>
</section>
