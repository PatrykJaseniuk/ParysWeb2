---
import Icon from "../../2-ui/ui/Icon.astro";
import SectionHead from "../../2-ui/ui/SectionHead.astro";
import PriceMatrix from "../pricing/PriceMatrix.astro";
import { contact, enrollmentFee, entryPrice, monthlyFrom, optionCount, pln, withBase } from "../../1-data/business";

const notes = [
  {
    icon: "check" as const,
    title: "Bez umowy",
    text: "Karnety są bezterminowe w tym sensie, że nie podpisujesz lojalnościówki — kupujesz dostęp na określony czas.",
  },
  {
    icon: "clock" as const,
    title: `Opłata wpisowa ${pln(enrollmentFee)}`,
    text: "Jednorazowo przy pierwszym zakupie karnetu. Nie dotyczy wejść jednorazowych.",
  },
  {
    icon: "users" as const,
    title: "Karty partnerskie",
    text: "MultiSport, Medicover Sport i FitProfit. PZU — zakres dostępu potwierdź w recepcji.",
  },
];
---

<section id="karnety" class="bg-bone text-ink">
  <div class="container-x py-14 sm:py-16 lg:py-20">
    <SectionHead
      index="02"
      label="Karnety"
      title="Cennik bez gwiazdek"
      description={`Cztery zakresy, ${optionCount} wariantów — od wejścia za ${pln(entryPrice)} po karnet roczny z dwoma miesiącami gratis. Karnet miesięczny już od ${pln(monthlyFrom)}.`}
      tone="light"
    />

    <div class="mt-10 lg:mt-12">
      <PriceMatrix tone="light" />
    </div>

    <!-- Trzy doprecyzowania -->
    <div class="mt-12 grid gap-px overflow-hidden border border-black/10 bg-black/10 sm:grid-cols-3">
      {
        notes.map((note) => (
          <div class="bg-bone p-6">
            <Icon name={note.icon} size={20} class="text-brand" />
            <h3 class="mt-4 font-display text-base font-bold uppercase tracking-tight">{note.title}</h3>
            <p class="mt-2 text-[13px] leading-relaxed text-black/60">{note.text}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-10 flex flex-col items-start justify-between gap-5 border-t border-black/15 pt-8 sm:flex-row sm:items-center">
      <p class="max-w-xl text-sm leading-relaxed text-black/60">
        Nie wiesz, który zakres wybrać? Recepcja podpowie przy pierwszej wizycie — albo zadzwoń,
        zanim przyjdziesz.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href={`tel:${contact.phone_e164}`} class="btn-light">
          <Icon name="phone" size={15} />
          <span class="num">{contact.phone}</span>
        </a>
        <a href={withBase("/karnety")} class="link-arrow self-center text-ink">
          Pełny cennik i FAQ
          <Icon name="arrow-up-right" size={15} />
        </a>
      </div>
    </div>
  </div>
</section>
